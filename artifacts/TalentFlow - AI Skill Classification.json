{
  "name": "TalentFlow - AI Skill Classification",
  "nodes": [
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n    p.person_id,\n    p.full_name,\n    p.email,\n    p.phone,\n    COALESCE(\n        STRING_AGG(ps.skill, ', ' ORDER BY ps.skill),\n        ''\n    ) AS skills\nFROM people p\nLEFT JOIN person_skills ps\n    ON p.person_id = ps.person_id\nWHERE p.person_id = {{ $json.body.record.person_id }}\n  AND p.skill_category IS NULL\nGROUP BY\n    p.person_id,\n    p.full_name,\n    p.email,\n    p.phone;",
        "options": {}
      },
      "id": "0df6b4e6-d8d9-4883-b39b-67b6a7fa2d43",
      "name": "Fetch Unclassified Candidates",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        -992,
        144
      ],
      "credentials": {
        "postgres": {
          "id": "F9JYGCDumZdZS9mP",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-5-mini",
          "cachedResultName": "gpt-5-mini"
        },
        "responses": {
          "values": [
            {
              "content": "=Classify this candidate into exactly one of these categories:\n\n- automation-heavy\n- web dev\n- data\n\nCandidate name: {{ $json.full_name }}\n\nCandidate skills:\n{{ $json.skills }}\n\nReturn ONLY the category name.\nDo not provide an explanation."
            }
          ]
        },
        "builtInTools": {},
        "options": {
          "instructions": "You are a skill classifier for a talent platform. Classify each candidate into exactly one of these categories based on their skills: \"automation-heavy\" (workflow automation, integration, no-code/low-code tools), \"web dev\" (frontend/backend web development), or \"data\" (data engineering, analytics, data science). Respond with only the category value.",
          "textFormat": {
            "textOptions": {
              "type": "json_schema",
              "name": "skill_category",
              "schema": "{\"type\":\"object\",\"additionalProperties\":false,\"properties\":{\"category\":{\"type\":\"string\",\"enum\":[\"automation-heavy\",\"web dev\",\"data\"]}},\"required\":[\"category\"]}",
              "strict": true
            }
          }
        }
      },
      "id": "7846262f-92f6-49af-8a68-52a807b1706e",
      "name": "Classify Skills",
      "type": "@n8n/n8n-nodes-langchain.openAi",
